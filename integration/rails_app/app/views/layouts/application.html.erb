<!DOCTYPE html>
<html>
  <head>
    <title>Inertia Imba integration</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script>
      // Apply the saved theme before first paint; app/frontend/lib/theme.imba takes over after load.
      try {
        var theme = localStorage.getItem('theme') || 'system';
        if (theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches))
          document.documentElement.classList.add('dark');
      } catch (e) {}
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= inertia_meta_tags %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "inertia.js" %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
